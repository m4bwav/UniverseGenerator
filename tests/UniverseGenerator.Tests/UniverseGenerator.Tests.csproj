<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0 everywhere; net48 on Windows exercises the netstandard2.0 build. net48 runs as win-x64: the x86 .NET
       Framework JIT computes doubles on the x87 unit, a separate determinism question (plan, risks). -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>UniverseGeneration.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1515;CA1861</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- The samples, compiled and run here on both frameworks so they cannot rot: the console sample's README examples
       and the Unity sample's engine-free code (SampleTests). -->
  <ItemGroup>
    <Compile Include="../../samples/ConsoleSample/Examples.cs" Link="Samples/Examples.cs" />
    <Compile Include="../../Packages/com.m4bwav.universe-generator/Samples~/GalaxyPrinter/GalaxyReport.cs" Link="Samples/GalaxyReport.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/UniverseGenerator/UniverseGenerator.csproj" />
  </ItemGroup>

</Project>
